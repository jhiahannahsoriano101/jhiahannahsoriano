<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Artificial Intelligence in Office Administration</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap');

    :root {
      --bg-1: #050816;
      --bg-2: #0d132b;
      --panel: rgba(17, 24, 39, 0.7);
      --panel-border: rgba(103, 232, 249, 0.3);
      --text: #e5f3ff;
      --muted: #a9c0d8;
      --cyan: #5ee7ff;
      --blue: #6ea8fe;
      --purple: #b197fc;
      --green: #7ef2c0;
      --shadow: 0 0 30px rgba(94, 231, 255, 0.35);
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(94, 231, 255, 0.18), transparent 30%),
        radial-gradient(circle at bottom right, rgba(177, 151, 252, 0.18), transparent 35%),
        linear-gradient(135deg, var(--bg-1), var(--bg-2));
      color: var(--text);
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      padding: 24px;
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 30px 30px;
      mask-image: radial-gradient(circle at center, black 40%, transparent 100%);
      pointer-events: none;
    }

    .hero {
      position: relative;
      width: min(1100px, 100%);
      padding: 48px 40px;
      border: 1px solid var(--panel-border);
      background: rgba(10, 18, 32, 0.72);
      border-radius: 28px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 15px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      pointer-events: none;
    }

    .content {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 32px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--cyan);
      margin-bottom: 18px;
      font-weight: 700;
    }

    h1 {
      margin: 0;
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 1.05;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #f3fbff;
      text-shadow: 0 0 20px rgba(94, 231, 255, 0.2);
    }

    .subtitle {
      margin-top: 18px;
      font-size: 1.08rem;
      line-height: 1.8;
      color: var(--muted);
      max-width: 620px;
    }

    .actions {
      margin-top: 30px;
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 26px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.03em;
      transition: 0.25s ease;
      border: 1px solid transparent;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--cyan), var(--blue));
      color: #05131b;
      box-shadow: 0 0 25px rgba(94, 231, 255, 0.45);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 35px rgba(94, 231, 255, 0.6);
    }

    .btn-secondary {
      border-color: rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.02);
      color: var(--text);
    }

    .btn-secondary:hover {
      border-color: rgba(94, 231, 255, 0.5);
      background: rgba(94, 231, 255, 0.06);
    }

    .info-panel {
      border: 1px solid var(--panel-border);
      background: rgba(8, 13, 28, 0.8);
      border-radius: 24px;
      padding: 28px 22px;
      box-shadow: inset 0 0 20px rgba(94, 231, 255, 0.06);
    }

    .panel-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--cyan);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .stats {
      display: grid;
      gap: 18px;
      margin-top: 16px;
    }

    .stat {
      padding: 16px 14px;
      border-radius: 16px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
    }

    .stat strong {
      display: block;
      font-size: 1.7rem;
      font-family: 'Orbitron', sans-serif;
      color: var(--green);
      margin-bottom: 6px;
    }

    .stat span {
      color: var(--muted);
      font-size: 0.9rem;
    }

    @media (max-width: 820px) {
      body {
        overflow: auto;
      }

      .hero {
        padding: 30px 20px;
      }

      .content {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: clamp(2.3rem, 11vw, 4rem);
      }
    }
  </style>
</head>
<body>
  <div class="bg-grid"></div>

  <main class="hero">
    <div class="content">
      <section>
        <div class="eyebrow">Office Innovation</div>
        <h1>Artificial Intelligence<br>in Office Administration</h1>
        <p class="subtitle">
          Transform everyday office tasks with smarter thinking, faster execution, and more efficient teamwork.
        </p>

        <div class="actions">
          <a href="page2.html" class="btn btn-primary">Explore AI Tools</a>
          <a href="#features" class="btn btn-secondary">Learn More</a>
        </div>
      </section>

      <aside class="info-panel" id="features">
        <div class="panel-title">AI Office Stack</div>

        <div class="stats">
          <div class="stat">
            <strong>Writing</strong>
            <span>Draft emails, reports, and summaries faster.</span>
          </div>

          <div class="stat">
            <strong>Scheduling</strong>
            <span>Automate meetings, calendar planning, and reminders.</span>
          </div>

          <div class="stat">
            <strong>Research</strong>
            <span>Gather insights and summaries in seconds.</span>
          </div>
        </div>
      </aside>
    </div>
  </main>
</body>
</html>